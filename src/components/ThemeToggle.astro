---
// Light/dark toggle. Invisible (but space-reserving) until JS runs, so it
// never shows a dead button and never shifts the layout.
import type { Lang } from "@/i18n/config";
import { t } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button
  type="button"
  class="theme-toggle inline-flex size-11 items-center justify-center"
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="theme-icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-icon-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
  </svg>
  <span class="sr-only">{t(lang)("theme.dark")}</span>
</button>

<script>
  const KEY = "theme";
  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const current = (): "light" | "dark" => {
    const explicit = root.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return system.matches ? "dark" : "light";
  };

  const sync = () => {
    const theme = current();
    for (const button of buttons) button.setAttribute("aria-pressed", String(theme === "dark"));
    const color = theme === "dark" ? "#0e0e0e" : "#f3f0e8";
    for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.setAttribute("content", color);
  };

  const choose = (theme: "light" | "dark") => {
    const followsSystem = theme === (system.matches ? "dark" : "light");
    try {
      if (followsSystem) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, theme);
    } catch {
      // Storage can be blocked; the choice still applies to this page view.
    }
    if (followsSystem) root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", theme);
    sync();
  };

  for (const button of buttons) {
    button.addEventListener("click", () => choose(current() === "dark" ? "light" : "dark"));
  }
  system.addEventListener("change", () => {
    if (!root.hasAttribute("data-theme")) sync();
  });
  sync();
</script>
