---
// A plain link to the same page in the other language. Its accessible name is
// its visible text ("Dansk"/"English"), so no aria-label is needed.
import { LANG_NAME, type Lang } from "@/i18n/config";
import { localeUrl, otherLang } from "@/i18n/utils";

interface Props {
  lang: Lang;
  /** Locale-neutral path of the current page ("" for home). */
  path?: string;
}

const { lang, path = "" } = Astro.props;
const target = otherLang(lang);
---

<a
  href={localeUrl(target, path)}
  hreflang={target}
  lang={target}
  class="inline-flex min-h-11 items-center px-3 font-mono text-sm underline-offset-4 hover:underline"
>
  {LANG_NAME[target]}
</a>
